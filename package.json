{
  "name": "@kd/i18n",
  "version": "0.2.0",
  "description": "One-command i18n automation for KeenData Vue2 projects",
  "keywords": [
    "i18n",
    "vue2",
    "voerkai18n",
    "automation",
    "llm"
  ],
  "main": "src/index.js",
  "files": [
    "bin",
    "src"
  ],
  "bin": {
    "i18n": "bin/kd-i18n.js",
    "kd-i18n": "bin/kd-i18n.js"
  },
  "dependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@voerkai18n/runtime": "^2.1.13",
    "@voerkai18n/vue2": "^2.1.13",
    "@vue/compiler-sfc": "2.7.15",
    "openai": "^7.4.0"
  },
  "scripts": {
    "lint": "eslint src/ test/ bin/",
    "lint:fix": "eslint --fix src/ test/ bin/",
    "dev:help": "node bin/kd-i18n.js help",
    "test": "node --test test/",
    "prepublishOnly": "npm test",
    "i18n:extract": "voerkai18n extract -D && prettier --write src/languages/*.*",
    "i18n:compile": "voerkai18n compile && prettier --write src/languages/*.*"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chanwanxia/keendata-i18n-agent"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@voerkai18n/cli": "^2.1.13",
    "eslint": "^9.39.5",
    "postcss": "^8.5.14",
    "postcss-html": "^1.8.1",
    "postcss-rtlcss": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "voerkai18n-loader": "^2.1.13"
  }
}
